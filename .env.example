# ===== 千问 API 配置（主通路）=====
# 阿里云 DashScope API Key（必填）
QWEN_API_KEY=sk-your-api-key-here
# API 地址（一般不需要改）
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称：qwen-vl-plus / qwen-vl-max
QWEN_MODEL=qwen-vl-plus

# ===== 备用 API 配置（可选，主通路 key 限流/欠费时自动切换）=====
# 同样是千问 DashScope，只是换一个 API Key
BACKUP_API_KEY=sk-your-backup-api-key-here
BACKUP_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BACKUP_MODEL=qwen-vl-plus

# ===== 重试配置 =====
API_MAX_RETRIES=3
API_RETRY_DELAY=1.5

# ===== 应用配置 =====
# 用户账号密码（JSON格式，可配置多个）
APP_USERS={"admin": "your-password-here"}
# JWT签名密钥（生产环境请用随机字符串）
JWT_SECRET=generate-a-random-secret-string
# Token过期时间（小时）
JWT_EXPIRY_HOURS=24

# ===== CORS（上线时改成实际域名）=====
CORS_ORIGINS=https://your-domain.com
